<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.Docker" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.5.3" />
  </ItemGroup>
  <ItemGroup Label="Marten">
    <PackageVersion Include="Marten" Version="9.30.0" />
    <PackageVersion Include="Marten.AspNetCore" Version="9.30.0" />
  </ItemGroup>
  <ItemGroup Label="Postgres">
    <!-- Direct reference for QuartzSchemaProvisioner's raw DDL bootstrap (#129); otherwise
         only arrives transitively via Marten. Version matches Marten's current transitive
         resolution. -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup Label="Wolverine">
    <PackageVersion Include="WolverineFx.Marten" Version="6.32.0" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.32.0" />
  </ItemGroup>
  <ItemGroup Label="AndreGoepel">
    <PackageVersion Include="AndreGoepel.Core" Version="1.0.2" />
    <PackageVersion Include="AndreGoepel.Design.Blazor" Version="1.6.5" />
    <PackageVersion Include="AndreGoepel.Marten.Identity.Blazor" Version="2.0.2" />
    <PackageVersion Include="AndreGoepel.Marten.Testing" Version="1.2.1" />
    <PackageVersion Include="AndreGoepel.Marten.Configuration" Version="1.2.2" />
    <PackageVersion Include="AndreGoepel.Testing.Bunit" Version="1.3.1" />
    <PackageVersion Include="AndreGoepel.Testing.E2E" Version="1.3.1" />
  </ItemGroup>
  <ItemGroup Label="OpenTelemetry">
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
  </ItemGroup>
  <ItemGroup Label="Microsoft">
    <PackageVersion Include="Microsoft.AspNetCore.HeaderPropagation" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.9.0" />
    <PackageVersion
      Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets"
      Version="1.23.0"
    />
  </ItemGroup>
  <ItemGroup Label="UI">
    <PackageVersion Include="Radzen.Blazor" Version="11.3.0" />
  </ItemGroup>
  <ItemGroup Label="Messaging">
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <PackageVersion Include="Quartz.Extensions.Hosting" Version="3.20.0" />
    <!-- Quartz core's default serializer (BinaryObjectSerializer) uses BinaryFormatter,
         which throws on .NET 8+ (removed for security reasons) — required, not optional,
         for the persistent job store (#129). -->
    <PackageVersion Include="Quartz.Serialization.SystemTextJson" Version="3.20.0" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="bunit" Version="2.9.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.62.0" />
    <PackageVersion Include="Otp.NET" Version="1.4.1" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.8" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>
</Project>
